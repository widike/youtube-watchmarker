{
  "name": "youtube-watchmarker",
  "version": "1.0.5",
  "description": "Chrome extension that automatically marks videos on YouTube that you have already watched",
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "echo 'Development mode - load unpacked extension from this directory'",
    "build": "node scripts/bundle-virtual.js && node scripts/bundle-word-language.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "keywords": [
    "youtube",
    "chrome-extension",
    "watch-history",
    "video-tracking"
  ],
  "author": "widike (fork of sniklaus/youtube-watchmarker)",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/widike/youtube-watchmarker",
  "repository": {
    "type": "git",
    "url": "https://github.com/widike/youtube-watchmarker"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "esbuild": "0.28.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "prettier": "3.5.3",
    "world-countries": "5.1.0"
  },
  "dependencies": {
    "@tanstack/virtual-core": "3.19.9",
    "franc-min": "6.2.0",
    "wink-lemmatizer": "3.0.4"
  }
}
